{
  "name": "printsaathi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:scripts",
    "pretest:scripts": "node scripts/preflight.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "preaudit": "node scripts/preflight.mjs",
    "audit": "node scripts/audit.mjs",
    "prelint": "node scripts/preflight.mjs",
    "lint": "biome check .",
    "pretypecheck": "node scripts/preflight.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/preflight.mjs",
    "test": "vitest run",
    "pretest:e2e": "node scripts/preflight.mjs",
    "test:e2e": "vite build --mode e2e && playwright test",
    "prebuild": "node scripts/preflight.mjs",
    "build": "vite build",
    "presize": "node scripts/preflight.mjs",
    "size": "node scripts/size.mjs",
    "preandroid:sync": "node scripts/preflight.mjs",
    "android:sync": "vite build && cap sync android",
    "preandroid:build": "node scripts/preflight.mjs",
    "android:build": "npm run android:sync && node scripts/android-env.mjs assembleDebug",
    "preandroid:release": "node scripts/preflight.mjs",
    "android:release": "npm run android:sync && node scripts/android-env.mjs assembleRelease && node scripts/check-manifest.mjs release && node scripts/check-release.mjs",
    "preandroid:test": "node scripts/preflight.mjs",
    "android:test": "node scripts/android-env.mjs lint testDebugUnitTest",
    "preandroid:check-manifest": "node scripts/preflight.mjs",
    "android:check-manifest": "node scripts/check-manifest.mjs release",
    "preandroid:write-locks": "node scripts/preflight.mjs",
    "android:write-locks": "node scripts/android-env.mjs :app:dependencies --write-locks",
    "preandroid:connected": "node scripts/preflight.mjs",
    "android:connected": "npm run android:sync && node scripts/android-env.mjs :app:connectedDebugAndroidTest"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@phosphor-icons/core": "2.1.1",
    "@preact/signals": "2.11.3",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.5.15",
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "fast-check": "4.10.2",
    "jpeg-js": "0.4.4",
    "pdfjs-dist": "6.3.289",
    "preact-render-to-string": "6.8.0",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
